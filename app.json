{
  "expo": {
    "name": "Rollhouse",
    "slug": "rollhouse",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A0A0D",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A0A0D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.omargh99.rollhouse"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A0A0D"
      },
      "package": "com.omargh99.rollhouse",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "omar_safar",
    "extra": {
      "eas": {
        "projectId": "e00749bc-d714-4611-b641-d3eb31cf6b75"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e00749bc-d714-4611-b641-d3eb31cf6b75"
    }
  }
}
